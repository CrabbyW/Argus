{
  "//": "Copy to appsettings.Development.json and fill in. appsettings*.json are gitignored per CLAUDE-dotnet.md.",
  "ConnectionStrings": {
    "ArgusDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=Argus;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Issuer": "Argus",
    "Audience": "ArgusClients",
    "SigningKey": "CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS",
    "TokenLifetimeMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Database": {
    "MigrateAndSeedOnStartup": true
  },
  "Seed": {
    "AdminPassword": "CHANGE_ME"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
